# xAI Speech to Speech / Voice Agent API
# Create a key at https://console.x.ai
XAI_API_KEY=xai-your-key-here

# Optional Voice Agent settings
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime
XAI_VOICE_MODEL=grok-voice-latest
XAI_VOICE=eve

# Local Postgres (docker compose publishes 55432 to avoid clashing with a
# Postgres already bound to 5432).
DATABASE_URL=postgresql://voice:voice@127.0.0.1:55432/voice_postgres

HOST=0.0.0.0
PORT=8765
